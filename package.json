{
  "name": "dsh-plugin-usage-pulse",
  "version": "1.0.1",
  "description": "Real-time DeepSeek peak / off-peak pricing, token usage and hourly usage meter for the DSH Web UI.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "wang7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunyu-feng/dsh-plugin-usage-pulse.git"
  },
  "homepage": "https://github.com/hunyu-feng/dsh-plugin-usage-pulse#readme",
  "bugs": {
    "url": "https://github.com/hunyu-feng/dsh-plugin-usage-pulse/issues"
  },
  "keywords": [
    "dsh-plugin",
    "token-usage",
    "pricing",
    "peak-off-peak",
    "usage-meter"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "holidays.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
